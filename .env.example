# Consus server configuration

# HTTP server
PORT=8722
HOST=127.0.0.1       # set 0.0.0.0 for containerized deploys

# Storage
CONSUS_DB_PATH=.pHive/consus.sqlite
CONSUS_ATTACHMENTS_DIR=.pHive/attachments
CONSUS_PROJECTS_CONFIG=.pHive/consus-projects.json
CONSUS_DISCOVERY_ROOTS=          # comma-separated absolute paths for GET /api/projects/discover

# Harness transport — select one, or leave all unset for no-op (proposals stay local)
#
# Option A: generic webhook transport
#   POSTs each proposal as { "method": "proposeChange", "params": {...} } to the URL; the receiver
#   reports results through POST /api/proposals/:id/result. For Pantheon, point it at core-api's
#   /api/feed/changes/webhook?origin=consus.
# CONSUS_HARNESS=webhook
# CONSUS_HARNESS_WEBHOOK_URL=http://localhost:3012/api/feed/changes/webhook?origin=consus
#
# Option B: file transport (standalone; answer with `node bin/handoff.mjs`)
# CONSUS_HARNESS_FILE_DIR=.pHive/handoffs
#
# Option C: custom stdio transport
#   Spawns an external command and speaks JSON over stdin/stdout.
# CONSUS_HARNESS_COMMAND=/path/to/harness-command
# CONSUS_HARNESS_ARGS=--arg1,--arg2    # comma-separated args passed to the command

# Pantheon pushes (optional, independent of the transport above)
#   Answers to imported question tickets, the verdict bridge and decision:needs-context are
#   POSTed to Pantheon core-api. Question tickets themselves are pushed in by Pantheon
#   (POST /api/questions/import, /api/questions/:ticket/close); Consus never polls.
# PANTHEON_API_URL=http://localhost:3012
