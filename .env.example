# Consus server configuration

# HTTP server
PORT=8722
HOST=127.0.0.1       # set 0.0.0.0 for containerized deploys

# Storage
CONSUS_DB_PATH=.pHive/consus.sqlite
CONSUS_ATTACHMENTS_DIR=.pHive/attachments
CONSUS_PROJECTS_CONFIG=.pHive/consus-projects.json
CONSUS_DISCOVERY_ROOTS=          # comma-separated absolute paths for GET /api/projects/discover

# Harness transport — select one, or leave both unset for no-op (proposals stay local)
#
# Option A: Pantheon board-feed transport
#   Forwards proposals to a Pantheon instance and pulls results back on a 60-second schedule.
CONSUS_HARNESS=pantheon
PANTHEON_API_URL=http://localhost:8800    # base URL of the Pantheon server
#
# Option B: custom stdio transport
#   Spawns an external command and speaks JSON over stdin/stdout.
# CONSUS_HARNESS_COMMAND=/path/to/harness-command
# CONSUS_HARNESS_ARGS=--arg1,--arg2    # comma-separated args passed to the command
